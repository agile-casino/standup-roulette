{
  "name": "standup-roulette",
  "version": "4.18.3",
  "description": "standup-roulette",
  "main": "src/index.tsx",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:watch": "vite build --watch",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "dev": "vite",
    "lint": "prettier --check \"**/*.{md,yml}\" && biome check && knip",
    "lint:fix": "prettier --write \"**/*.{md,yml}\" && biome check --write && knip --fix",
    "prune": "ts-prune",
    "sync": "node scripts/sync-manifest.js",
    "tcm": "tcm src/**/*.module.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "zip": "node scripts/zip-extension.js",
    "prepare": "lefthook install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agile-casino/standup-roulette.git"
  },
  "author": "archerax",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agile-casino/standup-roulette/issues"
  },
  "homepage": "https://github.com/agile-casino/standup-roulette#readme",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "renovate": {
    "bumpVersion": "patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tampermonkey": "^5.5.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "archiver": "^8.0.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.35.1",
    "lefthook": "^2.1.14",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "ts-prune": "^0.10.3",
    "typed-css-modules": "^0.9.1",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.0",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tabler/icons-react": "^3.46.0",
    "buffer": "^6.0.3",
    "crc": "^4.3.2",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-custom-roulette": "^1.4.1",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  }
